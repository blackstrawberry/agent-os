#!/bin/sh
# agent-os forced-sync git hook (opt-in).
# Enable once: git config core.hooksPath .agent-os/scripts/hooks
# 1) missing prompts frontmatter -> block the commit (hard fail)
# 2) code changed without a .agent-os/docs/ update -> warn (non-fatal)
#
# PERF: the prompt lint + reindex run ONLY when this commit actually stages
# files under .agent-os/prompts/. Ordinary code commits skip them, so a commit
# no longer pays for a full-tree frontmatter scan + full reindex every time.
# Compaction is NOT scanned here -- the SessionStart nudge (agent-os-notify.sh)
# already reports when compaction is due, so the commit path stays fast.
AOS=".agent-os"
root=$(git rev-parse --show-toplevel)

staged=$(git diff --cached --name-only)

# Only lint + reindex when this commit touches prompt docs.
if printf '%s\n' "$staged" | grep -q "^$AOS/prompts/"; then
  # Lint only the documents this commit adds or changes. A full-tree lint would hold
  # the commit hostage to every legacy document -- one install has 268 pre-existing
  # failures, so the hook could never pass there and would simply be turned off.
  # Touched documents are checked strictly, including enum values.
  changed=$(git diff --cached --name-only --diff-filter=ACMR -- "$AOS/prompts" | grep '\.md$')
  if [ -n "$changed" ]; then
    # shellcheck disable=SC2086
    sh "$root/$AOS/scripts/check-prompts.sh" $changed || {
      echo "[pre-commit] frontmatter check failed on the documents you are committing -- fix the items above and re-commit"
      echo "[pre-commit] whole-tree status (non-blocking): sh $AOS/scripts/check-prompts.sh --report"
      exit 1
    }
  fi
  if [ -f "$root/$AOS/scripts/reindex.sh" ]; then
    sh "$root/$AOS/scripts/reindex.sh" >/dev/null 2>&1 && git add "$AOS/prompts/index.jsonl" 2>/dev/null
  fi
fi

code=$(printf '%s\n' "$staged" | grep -vE '^(\.agent-os/|CLAUDE\.md|\.gitignore|README|AGENTS\.md|LICENSE)' || true)
if [ -n "$code" ] && ! printf '%s\n' "$staged" | grep -q '^\.agent-os/docs/'; then
  echo "[pre-commit][warn] code changed but no .agent-os/docs/ update staged -- check Source of Truth sync."
  echo "[pre-commit][warn] proceeding (this is a warning, not a block)."
fi
exit 0
